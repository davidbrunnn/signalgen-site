# Vercel Blob (Storage > Blob > connect to project): Vercel adds it for you. Holds the early access list and the catalog.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# the token the Mac uses (publish, judge, pack jobs) and the one that reads the early access list (any long string;
# the same goes in ~/Desktop/SignalGen/codigo/music-gen/engine/loja.json)
PUBLISH_TOKEN=troque-por-um-segredo-longo
# prices shown on the page, in USD
NEXT_PUBLIC_PRICE_MONTHLY=19
NEXT_PUBLIC_PRICE_LIFETIME=249
# ---- SALES (the checkout opens when STRIPE_SECRET_KEY is set AND the license key below is the plugins' pair) ----
# Stripe > Developers > API keys (sk_live_... ; sk_test_... to rehearse). Payment methods come from the Dashboard: card + Pix.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > endpoint https://<site>/api/webhook with checkout.session.completed and
# checkout.session.async_payment_succeeded (Pix) -> its signing secret
STRIPE_WEBHOOK_SECRET=
# the 64 hex digits of ~/Desktop/SignalGen/codigo/financeiro/licencas/private_key.hex (mark it Sensitive in Vercel)
SIGNALGEN_LICENSE_PRIVATE_KEY=
# what the key opens: bundle = SignalGen + Refiner + Ear (the .pkg v38); signalgen = only SignalGen
LICENSE_PRODUCT=bundle
# price of the lifetime license, in reais
PRICE_BRL=249
# the installer: by default the GitHub release vSIGNALGEN_VERSION of this repo (.../releases/download/v5.2.0/SignalGen-5.2.0-mac.pkg);
# set DOWNLOAD_URL_MAC only to host it elsewhere (it runs in DEMO without a key, so the link can be public)
SIGNALGEN_VERSION=5.2.0
DOWNLOAD_URL_MAC=
# license email (optional but recommended): resend.com API key + a sender on a domain verified there
RESEND_API_KEY=
MAIL_FROM=SignalGen <licencas@seudominio.com>
MAIL_REPLY_TO=
# public URL (no trailing slash)
SITE_URL=https://signalgen.vercel.app
