# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Vercel Blob (Storage > Blob > connect to project) - a Vercel preenche sozinha
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# o token que o Mac usa para publicar (qualquer string longa; o mesmo vai em ~/Desktop/SignalGen/codigo/music-gen/engine/loja.json)
PUBLISH_TOKEN=troque-por-um-segredo-longo
# segredo dos links de download (qualquer string longa)
DOWNLOAD_SECRET=troque-por-outro-segredo-longo
# URL publica do site (sem barra no fim)
SITE_URL=https://signalstudio.vercel.app
PRICE_USD=59

# SIGNALGEN PACK (any song -> Ableton pack); the Mac worker polls /api/pack/jobs with PUBLISH_TOKEN
PACK_PRICE_USD=19

# SignalGen product
PRODUCT_PRICE_USD=249
# Ed25519 seed used by the Mac keygen (codigo/financeiro/licencas/private_key.hex) — issues SGN1 keys on purchase. Never commit it.
LICENSE_SEED_HEX=
# 0 = tracks become demos (not for sale). Default: ghost productions, sold once each.
SELL_TRACKS=1

# SignalGen (10/10/2026): founder for the first 100 licenses, then lifetime. Brazil in R$, abroad in US$,
# Latin America = the R$ price in local currency (today's rate, lib/region.ts)
FOUNDER_SEATS=100
FOUNDER_PRICE_BRL=199
LIFETIME_PRICE_BRL=299
FOUNDER_PRICE_USD=49
LIFETIME_PRICE_USD=74

# Ghost production on demand (US$ 150): e-mails by Resend (resend.com > API Keys; MAIL_FROM on a verified domain)
RESEND_API_KEY=re_...
MAIL_FROM=SignalGen <producao@seu-dominio.com>
# where new orders and buyer messages arrive
GHOST_PRODUCER_EMAIL=brundavin@pm.me
# the producer desk /ghost/admin (any long string; falls back to PUBLISH_TOKEN)
GHOST_ADMIN_TOKEN=troque-por-um-segredo-longo

# 13/10/2026 — escada de preço (lib/region.ts). Vazio = padrão.
REFINER_PRICE_BRL=49.9
REFINER_PRICE_USD=12.9
SOUND_PRICE_BRL=19.9
SOUND_BUNDLE_PRICE_BRL=29.9
# Song Packs (vol. 17+) só entram na vitrine com SELL_SONGPACKS=1

# 13/10/2026 (tarde) — lançamento: Refiner R$ 49 e Monet R$ 99 para os 10 primeiros (lib/launch conta as vendas reais), depois o preço cheio.
# Os nomes antigos (REFINER_PRICE_BRL, MONET_PRICE_BRL, GHOST_PRICE_BRL) não são mais lidos.
REFINER_REGULAR_BRL=99
MONET_REGULAR_BRL=379
# quantas unidades de lançamento estavam abertas quando o contador entrou no ar
REFINER_LAUNCH_LEFT=2
MONET_LAUNCH_LEFT=1
GHOST_PRICE=1200
# packs fora da vitrine ("em breve") até PACKS_OPEN=1
PACKS_OPEN=
# conta do cliente (/entrar, /conta): segredo do cookie de sessão; sem ele, é derivado dos outros segredos do deploy
AUTH_SECRET=

# 13/10/2026 (noite) — fora do Brasil o preço é o MESMO NÚMERO em dólar (R$ 49 = US$ 49); não há mais câmbio nem preço em moeda local.
# FOUNDER_PRICE_USD, LIFETIME_PRICE_USD, MONET_REGULAR_USD e REFINER_REGULAR_USD não são mais lidos.

# 13/10/2026 — Ghost Production: R$ 2.000 no Brasil, US$ 600 fora (GHOST_PRICE não é mais lido)
GHOST_BRL=2000
GHOST_USD=600

# 13/10/2026 — ativação online dos plugins (POST /api/license/activate): usa o mesmo LICENSE_SEED_HEX das chaves.
# Chaves canceladas (reembolso, vazamento): seriais separados por vírgula. O serial aparece no plugin ("#100012") e no certificado.
LICENSE_REVOKED=
